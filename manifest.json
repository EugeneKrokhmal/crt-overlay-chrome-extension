{
  "name": "CRT Monitor Overlay",
  "short_name": "CRT Overlay",
  "description": "Retro CRT & VHS filter for any website. Scanlines, phosphor glow, film grain, glitch, lo-fi audio. Presets, side panel, shortcut.",
  "version": "0.2.0",
  "manifest_version": 3,
  "minimum_chrome_version": "114",
  "homepage_url": "https://github.com/EugeneKrokhmal/crt-overlay-chrome-extension",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "tabs", "sidePanel"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "run_at": "document_idle",
      "all_frames": false,
      "js": ["src/content/content.js"],
      "css": ["src/content/overlay.css"]
    }
  ],
  "action": {
    "default_title": "CRT Monitor Overlay — open settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "commands": {
    "toggle-crt": {
      "suggested_key": { "default": "Ctrl+Shift+C", "mac": "Command+Shift+C" },
      "description": "Toggle CRT overlay"
    }
  }
}
